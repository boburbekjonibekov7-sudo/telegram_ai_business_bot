# Telegram BotFather tokeni. GitHub’ga yozmang.
BOT_TOKEN=

# Telegram webhook yo‘lini himoyalovchi uzun random secret.
WEBHOOK_SECRET=
# Ixtiyoriy: Vercel production URL. Masalan https://my-bot.vercel.app
# PUBLIC_BASE_URL=

# Asosiy provider
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Qwen / Alibaba Cloud Model Studio (keyin qo‘shish mumkin)
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Kontekst sozlamalari
MAX_HISTORY_MESSAGES=12
SEND_ERROR_MESSAGE=false
DATA_DIR=data
