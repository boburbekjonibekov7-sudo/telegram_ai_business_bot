# Telegram BotFather tokeni. GitHub’ga yozmang.
BOT_TOKEN=

# Telegram webhook yo‘lini himoyalovchi uzun random secret.
WEBHOOK_SECRET=
# Ixtiyoriy: Vercel production URL. Masalan https://my-bot.vercel.app
# PUBLIC_BASE_URL=
# Ixtiyoriy: /rol va /role buyruqlarini faqat shu user ID boshqaradi.
# /id buyrug‘i orqali o‘z ID’ingizni bilib oling.
ADMIN_USER_ID=8645314130

# Asosiy provider
AI_PROVIDER=manus

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Manus API v2 (AI_PROVIDER=manus uchun)
MANUS_API_KEY=
MANUS_BASE_URL=https://api.manus.ai
MANUS_AGENT_PROFILE=manus-1.6-lite
MANUS_MAX_WAIT_SECONDS=45

# Qwen / Alibaba Cloud Model Studio (keyin qo‘shish mumkin)
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Kontekst sozlamalari
MAX_HISTORY_MESSAGES=12
SEND_ERROR_MESSAGE=true
MANUAL_REPLY_PAUSE_SECONDS=1800

# Ixtiyoriy: Vercel cold startlarida owner pause holatini saqlash uchun Upstash Redis REST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

DATA_DIR=data
